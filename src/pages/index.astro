---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SwipePreview from '../components/SwipePreview.astro';
import { getArticles, articleUrl, readingTime } from '../lib/articles';
import { SITE } from '../lib/site';
import research from '../assets/research.png';
import valuation from '../assets/article-valuation.png';
import phones from '../assets/phones.png';
import '../styles/journal.css';

const articles = await getArticles();
const picks = [
  { id: 'how-to-research-stocks', image: research },
  { id: 'negative-pe-ratio', image: valuation },
  { id: 'apple-stocks-vs-stocker', image: phones },
];
const featured = picks.map((pick) => {
  const article = articles.find((item) => item.id === pick.id);
  if (!article) throw new Error(`Featured article missing: ${pick.id}`);
  return { article, image: pick.image };
});
const more = articles
  .filter((article) => !picks.some((pick) => pick.id === article.id))
  .slice(0, 5);
---

<SiteLayout title="Stocker">
  <div class="container journal-home">
    <header class="journal-intro">
      <p class="eyebrow">Stocker journal</p>
      <h1>Stock research, made clearer.</h1>
      <p class="journal-description">
        Clear guides, app comparisons, and company research.
      </p>
    </header>
    <nav class="journal-topics" aria-label="Explore articles">
      <a href="/learn/">Investing basics <Arrow /></a>
      <a href="/compare/#app-comparisons">App comparisons <Arrow /></a>
      <a href="/companies/">Company research <Arrow /></a>
    </nav>
    <section class="journal-section" aria-labelledby="featured-heading">
      <div class="section-header">
        <h2 id="featured-heading">Featured articles</h2>
        <a class="text-link" href="/articles/">All articles <Arrow /></a>
      </div>
      <div class="journal-featured">
        {
          featured.map(({ article, image }) => (
            <ArticleCard
              article={article}
              image={image}
              featured
              summary={false}
            />
          ))
        }
      </div>
    </section>
    <section class="journal-section" aria-labelledby="more-heading">
      <div class="section-header"><h2 id="more-heading">More articles</h2></div>
      <div class="journal-list">
        {
          more.map((article) => (
            <a href={articleUrl(article)}>
              <h3>{article.data.title}</h3>
              <span>
                {readingTime(article.body)} min read <Arrow />
              </span>
            </a>
          ))
        }
      </div>
      <a class="text-link journal-browse" href="/articles/"
        >Browse all {articles.length} articles <Arrow /></a
      >
    </section>
    <aside class="journal-download" aria-label="Discover the Stocker app">
      <div class="journal-download-copy">
        <h2>Swipe to discover.</h2>
      </div>
      <div class="journal-app-visual">
        <SwipePreview />
      </div>
      <div class="journal-download-action">
        <a class="button button-blue" href={SITE.appStore} data-primary-download
          >Download Stocker <Arrow diagonal /></a
        >
      </div>
    </aside>
    <p class="journal-tools-link">
      Working through a number? <a href="/tools/"
        >Try the free calculators <Arrow /></a
      >
    </p>
  </div>
</SiteLayout>
