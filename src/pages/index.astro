---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AppCta from '../components/AppCta.astro';
import { getArticles, articleUrl } from '../lib/articles';
import research from '../assets/research.png';
const articles = await getArticles();
const featured = articles.filter((article) =>
  ['apple-stocks-vs-stocker', 'nvidia-vs-amd'].includes(article.id),
);
const latest = articles.filter((article) =>
  [
    'how-to-research-stocks',
    'negative-pe-ratio',
    'revenue-vs-earnings',
    'sector-vs-industry',
  ].includes(article.id),
);
---

<SiteLayout title="Stocker">
  <div class="container">
    <section class="hero">
      <div>
        <p class="eyebrow">Stocker journal</p>
        <h1>
          <span>Good research.</span><br /><span>Better questions.</span>
        </h1><p>
          Understand companies, compare your options, and find your next
          discovery.
        </p><div class="hero-actions">
          <a class="button button-blue" href="/learn/"
            >Explore guides <Arrow /></a
          ><a class="button button-link" href="/app/"
            >Meet Stocker <Arrow diagonal /></a
          >
        </div>
      </div><Image
        class="hero-art"
        src={research}
        alt="Illustration of research sheets viewed through a magnifying glass"
        width={760}
        height={506}
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
    </section>
    <nav class="topic-strip" aria-label="Explore topics">
      <span class="eyebrow">Explore</span>
      <a href="/learn/">Investing basics <Arrow /></a>
      <a href="/compare/#company-comparisons">Stock comparisons <Arrow /></a>
      <a href="/companies/">Company research <Arrow /></a>
    </nav>
    <section class="section">
      <div class="section-header">
        <h2>Worth a closer look</h2><a class="text-link" href="/compare/"
          >View comparisons <Arrow diagonal /></a
        >
      </div><div class="comparison-features">
        {featured.map((article) => <ArticleCard article={article} featured />)}
      </div>
    </section>
    <section class="section">
      <div class="section-header">
        <h2>Start with the basics</h2>
      </div><div class="story-list">
        {
          latest.map((article) => (
            <a href={articleUrl(article)}>
              <>
                <span class="category-label">{article.data.category}</span>
                <h3>{article.data.title}</h3>
                <Arrow />
              </>
            </a>
          ))
        }
      </div>
    </section>
    <section class="tool-band">
      <div>
        <h2>Make sense of the numbers</h2><p>
          Free calculators with the formulas explained.
        </p>
      </div><div class="tool-band-links">
        <a class="text-link" href="/tools/pe-ratio-calculator/"
          >P/E calculator <Arrow diagonal /></a
        ><a class="text-link" href="/tools/market-cap-calculator/"
          >Market cap calculator <Arrow diagonal /></a
        >
      </div>
    </section>
    <AppCta />
  </div>
</SiteLayout>
