---
import Arrow from './Arrow.astro';
import SwipePreview from './SwipePreview.astro';
import { appStoreUrl } from '../lib/site';
interface Props {
  title?: string;
  compact?: boolean;
}
const { title = 'Swipe to discover.', compact = false } = Astro.props;
---

<aside class:list={['app-cta', { compact }]} aria-label="Explore Stocker">
  <div>
    <h2>{title}</h2>
  </div>
  <div class="app-cta-action">
    <SwipePreview />
    <a
      class="button button-blue"
      href={appStoreUrl(Astro.url.pathname)}
      data-primary-download>Download Stocker <Arrow diagonal /></a
    >
  </div>
</aside>
