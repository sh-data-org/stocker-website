---
import SwipePreview from './SwipePreview.astro';
import Arrow from './Arrow.astro';
import { SITE } from '../lib/site';
interface Props {
  variant: 'sidebar' | 'bar';
}
const { variant } = Astro.props;
---

<aside
  class:list={['download-cta', `download-${variant}`]}
  aria-label="Download Stocker"
>
  {variant === 'bar' && <SwipePreview compact />}
  <div class="download-copy">
    <p class="download-title">
      {variant === 'sidebar' ? 'Swipe to discover.' : 'Stocker'}
    </p>
  </div>
  {variant === 'sidebar' && <SwipePreview />}
  <a
    class="button button-blue download-button"
    href={SITE.appStore}
    aria-label="Download Stocker on the App Store"
    data-primary-download={variant === 'sidebar' ? '' : undefined}
  >
    <span class="download-desktop-label">Download Stocker</span>
    <span class="download-mobile-label">Download</span>
    <Arrow diagonal />
  </a>
</aside>

<script>
  import '../scripts/download-cta';
</script>
