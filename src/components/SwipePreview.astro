---
import { getImage } from 'astro:assets';
import poster from '../assets/swipe-demo-poster.png';
interface Props {
  compact?: boolean;
  controls?: boolean;
}
const { compact = false, controls = true } = Astro.props;
const Frame = controls ? 'button' : 'div';
const preview = await getImage({ src: poster, width: 720, format: 'webp' });
---

<div class:list={['swipe-preview', { 'swipe-preview-small': compact }]}>
  <Frame
    class:list={['swipe-preview-screen', { 'swipe-preview-control': controls }]}
    type={controls ? 'button' : undefined}
    aria-label={controls ? 'Play Stocker swipe demo' : undefined}
    data-swipe-control={controls ? '' : undefined}
  >
    <video
      width="720"
      height="926"
      poster={preview.src}
      data-source="/videos/stocker-swipe-liked.mp4"
      muted
      playsinline
      preload="none"
      aria-hidden="true"
    >
      Your browser does not support this app preview.
    </video>
  </Frame>
</div>

<script>
  import '../scripts/swipe-preview';
</script>
