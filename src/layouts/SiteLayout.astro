---
import Header from '../components/Header.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import Footer from '../components/Footer.astro';
import DownloadCta from '../components/DownloadCta.astro';
import { SITE, canonicalUrl, safeJson } from '../lib/site';
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  article?: boolean;
}
const {
  title,
  description = SITE.description,
  noindex = false,
  schema,
  article = false,
} = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname);
const pageTitle =
  title === 'Stocker'
    ? 'Stocker — Good research. Better questions.'
    : `${title} | Stocker`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101f35" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link
      rel="preload"
      href="/fonts/poppins-regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow'}
    />
    <meta property="og:type" content={schema ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={canonicalUrl('/images/social.png')} />
    <meta property="og:site_name" content="Stocker" />
    <meta name="twitter:card" content="summary_large_image" />
    {
      schema && (
        <script type="application/ld+json" set:html={safeJson(schema)} />
      )
    }
  </head>
  <body class="has-download-cta">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <DownloadCta variant="bar" article={article} />
    <AnalyticsConsent />
  </body>
</html>
