---
import { Image, getImage } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import SiteLayout from './SiteLayout.astro';
import AppCta from '../components/AppCta.astro';
import DownloadCta from '../components/DownloadCta.astro';
import {
  articleImages,
  articleUrl,
  readingTime,
  type Article,
} from '../lib/articles';
import { canonicalUrl } from '../lib/site';
import { organizationId } from '../lib/structured-data';
interface Props {
  article: Article;
  headings: MarkdownHeading[];
  related: Article[];
}
const { article, headings, related } = Astro.props;
const { data } = article;
const socialImage = await getImage({
  src: articleImages[data.image],
  width: 1200,
  height: 800,
  format: 'webp',
  fit: 'cover',
});
const imageUrl = canonicalUrl(socialImage.src);
const publishedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${data.date}T00:00:00Z`));
const label =
  data.section === 'learn'
    ? 'Learn'
    : data.section === 'compare'
      ? 'Compare'
      : 'Companies';
const contents = headings.filter((heading) => heading.depth === 2);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    image: [imageUrl],
    inLanguage: 'en',
    articleSection: data.category,
    citation: data.sources.map((source) => source.url),
    datePublished: data.date,
    dateModified: data.date,
    author: {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Stocker',
      url: canonicalUrl('/about/'),
    },
    publisher: {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Stocker',
      url: canonicalUrl('/'),
    },
    mainEntityOfPage: canonicalUrl(articleUrl(article)),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: canonicalUrl('/'),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: label,
        item: canonicalUrl(`/${data.section}/`),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: data.title,
        item: canonicalUrl(articleUrl(article)),
      },
    ],
  },
];
---

<SiteLayout
  title={data.title}
  description={data.description}
  schema={schema}
  image={imageUrl}
>
  <article class="container">
    <div class="article-hero">
      <div>
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href={`/${data.section}/`}
            >{label}</a
          ><span>/</span><span>{data.category}</span>
        </nav>
        <h1>{data.title}</h1><p class="article-intro">{data.description}</p>
        <p class="article-byline">
          <a href="/about/">By the Stocker team</a> · <time datetime={data.date}
            >{publishedDate}</time
          > · {readingTime(article.body)} min read
        </p>
        {data.disclosure && <p class="disclosure">{data.disclosure}</p>}
      </div>
      <figure class="article-hero-image">
        <Image
          src={articleImages[data.image]}
          alt={data.imageAlt}
          width={640}
          height={460}
          format="webp"
          fit="cover"
          loading="eager"
        />
        {
          data.imageCredit && (
            <figcaption>
              Photo by{' '}
              <a
                href={data.imageCredit.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {data.imageCredit.photographer} on Pexels
              </a>
            </figcaption>
          )
        }
      </figure>
    </div>
    <div class="article-layout">
      <aside class="contents">
        <nav aria-label="On this page">
          <strong>On this page</strong>{
            contents.map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))
          }<a href="#sources">Sources</a>
        </nav>
      </aside>
      <div class="article-content">
        <div class="prose"><slot /></div>
        <section class="sources" id="sources">
          <h2>Sources & further reading</h2><p>
            Based on the sources below. Company and app information can change;
            check the original source before relying on it.
          </p><ul>
            {
              data.sources.map((source) => (
                <li>
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {source.title} ↗
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
        <AppCta compact />
        <p class="editorial-note">
          Stocker makes tools for discovery and research. This article is
          educational and is not a recommendation to buy, sell or hold any
          security. <a href="/about/#editorial-policy">How we write</a>
        </p>
      </div>
      <DownloadCta variant="sidebar" />
    </div>
    {
      related.length > 0 && (
        <section class="related-section">
          <>
            <h2>Keep exploring</h2>
            <div class="related-links">
              {related.map((item) => (
                <a href={articleUrl(item)}>
                  <span>{item.data.category}</span>
                  <h3>{item.data.title}</h3>
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </>
        </section>
      )
    }
  </article>
</SiteLayout>
